# ── 配置常量 ──────────────────────────────────────────────────────────────────

DEFAULT_INSTALL_ROOT = Path("/opt/autoaim")
DEFAULT_PLAYER_PORT = 18080
DEFAULT_MEDIAMTX_PORT = 8889
PLAYER_ROUTE = "/res/playing.html"
PLAYER_FILE = "playing.html"
FIFO_RECORDER_START = "/tmp/autoaim/recorder/start"
FIFO_RECORDER_STOP = "/tmp/autoaim/recorder/stop"
CONTEXT_RECORDER_PATH = "/tmp/autoaim/recorder/context"
FIFO_PLAYER_PAUSE = "/tmp/autoaim/player/pause"
FIFO_PLAYER_STEP = "/tmp/autoaim/player/step"
CONTEXT_PLAYER_PATH = "/tmp/autoaim/player/context"
AUTOAIM_PROCESS_NAME = "rmcs_executor"
MEDIAMTX_STOP_TIMEOUT = 5
PR_SET_PDEATHSIG = 1
CLOCK_TICKS = os.sysconf("SC_CLK_TCK")
CPU_COUNT = os.cpu_count() or 1
CAMERA_COMPONENT = os.environ.get("AUTOAIM_CAMERA_COMPONENT", "auto_aim_capturer")
CAMERA_STATE_MAX_AGE = 2.0
CAMERA_COMMAND_TIMEOUT = 2.0
CAMERA_COMMAND_LIFETIME = 1.8
CAMERA_MAX_BODY_BYTES = 4096
CAMERA_MAX_STATE_BYTES = 65536
CAMERA_REQUEST_TIMEOUT = 3.0
CAMERA_PARAMETERS = ("exposure_us", "gain")
CAMERA_COMMAND_LOCK = threading.Lock()
CAMERA_STATE_LOCK = threading.Lock()
CAMERA_LAST_STATE: dict | None = None
DETECTION_STATE_MAX_AGE = 2.0
DETECTION_COMMAND_TIMEOUT = 2.0
DETECTION_COMMAND_LIFETIME = 1.8
DETECTION_STATUSES = ("idle", "starting", "running", "error", "unavailable")
DETECTION_COMMAND_LOCK = threading.Lock()
DETECTION_STATE_LOCK = threading.Lock()
DETECTION_LAST_STATE: dict | None = None


# ── 相机控制 ──────────────────────────────────────────────────────────────────


class CameraApiError(Exception):
    def __init__(self, code: int, message: str, camera: dict | None = None) -> None:
        super().__init__(message)
        self.code = code
        self.camera = camera


def camera_paths() -> tuple[Path, Path]:
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", CAMERA_COMPONENT) is None:
        raise CameraApiError(503, "AUTOAIM_CAMERA_COMPONENT must be a simple component name")
    directory = Path("/tmp/autoaim/camera") / CAMERA_COMPONENT
    return directory / "state.json", directory / "commands"


def camera_finite_number(value: object) -> bool:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return False
    try:
        return math.isfinite(value)
    except OverflowError:
        return False


def camera_reject_json_constant(value: str) -> None:
    raise ValueError(f"Invalid JSON number: {value}")


def camera_parse_json_float(value: str) -> float:
    number = float(value)
    if not math.isfinite(number):
        raise ValueError("JSON number is not finite")
    return number


def camera_parameter_valid(limits: object) -> bool:
    return (isinstance(limits, dict)
            and all(camera_finite_number(limits.get(key)) for key in ("value", "min", "max"))
            and limits["min"] <= limits["value"] <= limits["max"])


def remember_camera_state(camera: dict) -> dict:
    global CAMERA_LAST_STATE
    with CAMERA_STATE_LOCK:
        previous = CAMERA_LAST_STATE or {}
        snapshot = dict(camera)
        for parameter in CAMERA_PARAMETERS:
            if not camera_parameter_valid(snapshot.get(parameter)):
                snapshot[parameter] = previous.get(parameter)
        CAMERA_LAST_STATE = snapshot
        return dict(camera)


def unavailable_camera_state(message: str, camera: dict | None = None) -> dict:
    with CAMERA_STATE_LOCK:
        snapshot = dict(CAMERA_LAST_STATE or {})
    if camera is not None:
        for key, value in camera.items():
            if key not in CAMERA_PARAMETERS or camera_parameter_valid(value):
                snapshot[key] = value
    snapshot.setdefault("pid", 0)
    snapshot.setdefault("updated_at", 0)
    snapshot.setdefault("last_request", None)
    for parameter in CAMERA_PARAMETERS:
        snapshot.setdefault(parameter, None)
    snapshot["connected"] = False
    snapshot["error"] = message
    return snapshot


def read_camera_state(require_connected: bool = True) -> dict:
    state_path, _ = camera_paths()
    try:
        with state_path.open("rb") as source:
            content = source.read(CAMERA_MAX_STATE_BYTES + 1)
        if len(content) > CAMERA_MAX_STATE_BYTES:
            raise ValueError("Camera state is too large")
        camera = json.loads(content, parse_constant=camera_reject_json_constant,
                            parse_float=camera_parse_json_float)
    except (OSError, ValueError, RecursionError) as error:
        raise CameraApiError(503, f"Camera state unavailable for {CAMERA_COMPONENT}") from error
    if not isinstance(camera, dict):
        raise CameraApiError(503, "Invalid camera state")
    pid = camera.get("pid")
    updated_at = camera.get("updated_at")
    if (not isinstance(pid, int) or isinstance(pid, bool) or not 0 < pid <= 2147483647
            or not camera_finite_number(updated_at)
            or not isinstance(camera.get("connected"), bool)):
        raise CameraApiError(503, "Invalid camera state", camera)
    age = time.time() - updated_at
    if age > CAMERA_STATE_MAX_AGE or age < -CAMERA_STATE_MAX_AGE:
        raise CameraApiError(503, "Camera state expired", camera)
    try:
        os.kill(pid, 0)
    except ProcessLookupError as error:
        raise CameraApiError(503, "Camera component process is not running", camera) from error
    except PermissionError:
        pass
    except OSError as error:
        raise CameraApiError(503, "Cannot check camera component process", camera) from error
    if require_connected:
        validate_connected_camera(camera)
    return remember_camera_state(camera)


def validate_connected_camera(camera: dict) -> None:
    if camera.get("connected") is not True:
        message = camera.get("error")
        raise CameraApiError(503, message if isinstance(message, str) and message
                             else "Camera disconnected; waiting for reconnection", camera)
    if not all(camera_parameter_valid(camera.get(parameter)) for parameter in CAMERA_PARAMETERS):
        raise CameraApiError(503, "Camera parameter readback unavailable", camera)


def camera_context_state() -> dict:
    try:
        return read_camera_state()
    except CameraApiError as error:
        return unavailable_camera_state(str(error), error.camera)


def write_camera_command(command: bytes) -> None:
    _, command_path = camera_paths()
    fd = None
    try:
        fd = os.open(command_path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
        if not stat.S_ISFIFO(os.fstat(fd).st_mode):
            raise OSError("Camera command path is not a FIFO")
        if os.write(fd, command) != len(command):
            raise OSError("Incomplete camera command")
    except OSError as error:
        raise CameraApiError(503, "Camera command channel unavailable") from error
    finally:
        if fd is not None:
            os.close(fd)


def update_camera(parameter: str, value: float) -> dict:
    if not CAMERA_COMMAND_LOCK.acquire(timeout=CAMERA_COMMAND_TIMEOUT):
        raise CameraApiError(503, "Another camera update is in progress")
    try:
        deadline = time.monotonic() + CAMERA_COMMAND_TIMEOUT
        camera = read_camera_state()
        limits = camera[parameter]
        if not limits["min"] <= value <= limits["max"]:
            raise CameraApiError(400, f"{parameter} must be between {limits['min']} and {limits['max']}", camera)
        pid = camera["pid"]
        request_id = uuid.uuid4().hex
        expires_at = int((time.time() + CAMERA_COMMAND_LIFETIME) * 1000)
        command = f"{request_id} {parameter} {value:.17g} {expires_at}\n".encode("ascii")
        write_camera_command(command)
        while time.monotonic() < deadline:
            camera = read_camera_state(require_connected=False)
            if camera["pid"] != pid:
                raise CameraApiError(503, "Camera component restarted during the update", camera)
            result = camera.get("last_request")
            if isinstance(result, dict) and result.get("id") == request_id:
                if result.get("parameter") != parameter:
                    raise CameraApiError(500, "Unexpected camera command acknowledgement", camera)
                if result.get("ok") is True:
                    validate_connected_camera(camera)
                    return camera
                message = result.get("error")
                raise CameraApiError(500, message if isinstance(message, str) and message
                                     else "Camera rejected the parameter update", camera)
            if camera["connected"] is not True:
                validate_connected_camera(camera)
            time.sleep(0.025)
        raise CameraApiError(504, "Timed out waiting for camera readback", camera)
    finally:
        CAMERA_COMMAND_LOCK.release()


# ── 识别预览控制 ──────────────────────────────────────────────────────────────


class DetectionApiError(Exception):
    def __init__(self, code: int, message: str, detection: dict | None = None) -> None:
        super().__init__(message)
        self.code = code
        self.detection = detection


def detection_paths() -> tuple[Path, Path]:
    try:
        camera_paths()
    except CameraApiError as error:
        raise DetectionApiError(error.code, str(error)) from error
    directory = Path("/tmp/autoaim/detection") / CAMERA_COMPONENT
    return directory / "state.json", directory / "commands"


def unavailable_detection_state(message: str, detection: dict | None = None) -> dict:
    with DETECTION_STATE_LOCK:
        snapshot = dict(DETECTION_LAST_STATE or {})
    if detection is not None:
        snapshot.update(detection)
    snapshot.setdefault("pid", 0)
    snapshot.setdefault("updated_at", 0)
    snapshot.setdefault("capturer_component", CAMERA_COMPONENT)
    snapshot.setdefault("last_request", {"id": "", "ok": False, "error": ""})
    snapshot["available"] = False
    snapshot["enabled"] = False
    snapshot["status"] = "unavailable"
    snapshot["error"] = message
    return snapshot


def read_detection_state(require_available: bool = True) -> dict:
    global DETECTION_LAST_STATE
    state_path, _ = detection_paths()
    try:
        with state_path.open("rb") as source:
            content = source.read(CAMERA_MAX_STATE_BYTES + 1)
        if len(content) > CAMERA_MAX_STATE_BYTES:
            raise ValueError("Detection state is too large")
        detection = json.loads(content, parse_constant=camera_reject_json_constant,
                               parse_float=camera_parse_json_float)
    except (OSError, ValueError, RecursionError) as error:
        raise DetectionApiError(503, f"Detection state unavailable for {CAMERA_COMPONENT}") from error
    if not isinstance(detection, dict):
        raise DetectionApiError(503, "Invalid detection state")
    pid = detection.get("pid")
    updated_at = detection.get("updated_at")
    result = detection.get("last_request")
    if (not isinstance(pid, int) or isinstance(pid, bool) or not 0 < pid <= 2147483647
            or not camera_finite_number(updated_at)
            or not isinstance(detection.get("available"), bool)
            or not isinstance(detection.get("enabled"), bool)
            or detection.get("status") not in DETECTION_STATUSES
            or not isinstance(detection.get("error"), str)
            or not isinstance(result, dict)
            or not isinstance(result.get("id"), str)
            or not isinstance(result.get("ok"), bool)
            or not isinstance(result.get("error"), str)):
        raise DetectionApiError(503, "Invalid detection state", detection)
    if detection.get("capturer_component") != CAMERA_COMPONENT:
        raise DetectionApiError(503, "Detection capturer component does not match", detection)
    age = time.time() - updated_at
    if age > DETECTION_STATE_MAX_AGE or age < -DETECTION_STATE_MAX_AGE:
        raise DetectionApiError(503, "Detection state expired", detection)
    try:
        os.kill(pid, 0)
    except ProcessLookupError as error:
        raise DetectionApiError(503, "Detection component process is not running", detection) from error
    except PermissionError:
        pass
    except OSError as error:
        raise DetectionApiError(503, "Cannot check detection component process", detection) from error
    with DETECTION_STATE_LOCK:
        DETECTION_LAST_STATE = dict(detection)
    if require_available and not detection["available"]:
        raise DetectionApiError(503, detection["error"] or "Detection preview is unavailable", detection)
    return detection


def detection_context_state() -> dict:
    try:
        return read_detection_state(require_available=False)
    except DetectionApiError as error:
        return unavailable_detection_state(str(error), error.detection)


def write_detection_command(command: bytes) -> None:
    _, command_path = detection_paths()
    fd = None
    try:
        fd = os.open(command_path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
        if not stat.S_ISFIFO(os.fstat(fd).st_mode):
            raise OSError("Detection command path is not a FIFO")
        if os.write(fd, command) != len(command):
            raise OSError("Incomplete detection command")
    except OSError as error:
        raise DetectionApiError(503, "Detection command channel unavailable") from error
    finally:
        if fd is not None:
            os.close(fd)


def update_detection(enabled: bool, player_paused_reader) -> dict:
    if not DETECTION_COMMAND_LOCK.acquire(timeout=DETECTION_COMMAND_TIMEOUT):
        raise DetectionApiError(503, "Another detection update is in progress")
    try:
        deadline = time.monotonic() + DETECTION_COMMAND_TIMEOUT
        if enabled:
            try:
                camera = read_camera_state()
            except CameraApiError as error:
                raise DetectionApiError(503, str(error)) from error
            if (camera.get("component_type") != "rmcs::AutoAimTunableCapturerComponent"
                    or camera.get("component_name") != CAMERA_COMPONENT):
                raise DetectionApiError(503, "Detection requires the selected tunable capturer")
            try:
                player_paused_reader()
            except OSError:
                pass
            else:
                raise DetectionApiError(503, "Detection preview cannot start during player playback")
        detection = read_detection_state(require_available=enabled)
        pid = detection["pid"]
        request_id = uuid.uuid4().hex
        expires_at = int((time.time() + DETECTION_COMMAND_LIFETIME) * 1000)
        command = f"{request_id} {int(enabled)} {expires_at}\n".encode("ascii")
        write_detection_command(command)
        while time.monotonic() < deadline:
            detection = read_detection_state(require_available=False)
            if detection["pid"] != pid:
                raise DetectionApiError(503, "Detection component restarted during the update", detection)
            result = detection["last_request"]
            if result["id"] == request_id:
                if result["ok"]:
                    return detection
                raise DetectionApiError(500, result["error"] or "Detection rejected the update", detection)
            if enabled and not detection["available"]:
                raise DetectionApiError(503, detection["error"] or "Detection preview is unavailable", detection)
            time.sleep(0.025)
        raise DetectionApiError(504, "Timed out waiting for detection acknowledgement", detection)
    finally:
        DETECTION_COMMAND_LOCK.release()


# ── 系统状态采集 ──────────────────────────────────────────────────────────────


def read_proc_stat() -> tuple[int, int]:
    """读取 /proc/stat，返回 (空闲节拍, 总节拍)。"""
    with open("/proc/stat", "r") as f:
        fields = f.readline().split()
    values = [int(x) for x in fields[1:]]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return idle, sum(values)


def read_mem_info() -> tuple[int, int]:
    """读取 /proc/meminfo，返回 (总内存 KB, 可用内存 KB)。"""
    total = available = 0
    with open("/proc/meminfo", "r") as f:
        for line in f:
            name, _, content = line.partition(":")
            if name == "MemTotal":
                total = int(content.split()[0])
            elif name == "MemAvailable":
                available = int(content.split()[0])
    if not total:
        raise OSError("Empty /proc/meminfo")
    return total, available


def read_load_avg() -> str:
    with open("/proc/loadavg", "r") as f:
        return " ".join(f.read().split()[:3])


def find_autoaim_pid() -> int | None:
    """按 comm 匹配自瞄宿主进程，返回 pid。"""
    self_pid = os.getpid()
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == self_pid:
            continue
        try:
            with open(f"/proc/{entry}/comm", "r") as f:
                if f.read().strip() == AUTOAIM_PROCESS_NAME:
                    return int(entry)
        except OSError:
            continue
    return None


def read_process_ticks(pid: int) -> int:
    """读取 /proc/<pid>/stat，返回用户态与内核态节拍之和。"""
    with open(f"/proc/{pid}/stat", "r") as f:
        content = f.read()
    fields = content[content.rindex(")") + 1:].split()
    return int(fields[11]) + int(fields[12])


def read_process_rss_kb(pid: int) -> int:
    with open(f"/proc/{pid}/status", "r") as f:
        for line in f:
            if line.startswith("VmRSS:"):
                return int(line.split()[1])
    raise OSError(f"No VmRSS for pid {pid}")


# ── HTTP Handler ─────────────────────────────────────────────────────────────


class AutoAimHandler(SimpleHTTPRequestHandler):
    """处理 HTTP 请求，提供静态文件、录制、回放和相机控制 API。"""

    root_directory: str = str(DEFAULT_INSTALL_ROOT)
    last_system_sample: tuple[int, int] | None = None
    last_proc_sample: tuple[int, int, float] | None = None
    sample_lock = threading.Lock()

    def do_GET(self) -> None:
        if self.path in ("/autoaim", "/autoaim/"):
            self.path = PLAYER_ROUTE
        elif self.path == "/api/context":
            self._api_context()
            return
        super().do_GET()

    def do_POST(self) -> None:
        handler = self._POST_ROUTES.get(self.path)
        if handler is None:
            self.send_error(404, "Not Found")
            return
        handler(self)

    def _api_record(self) -> None:
        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length).decode().strip()

        if body in ("1", "true"):
            self._write_fifo(FIFO_RECORDER_START, "1")
        elif body in ("0", "false"):
            self._write_fifo(FIFO_RECORDER_STOP, "1")
        else:
            self._json_response(
                400, {"status": "error", "message": "invalid value"})

    def _api_play_pause(self) -> None:
        try:
            paused = self._read_player_paused()
        except OSError as e:
            self._json_response(503, {"status": "error", "message": str(e)})
            return
        self._write_fifo(FIFO_PLAYER_PAUSE, "false" if paused else "true")

    def _api_step_forward(self) -> None:
        self._write_fifo(FIFO_PLAYER_STEP, "1")

    def _api_step_backward(self) -> None:
        self._write_fifo(FIFO_PLAYER_STEP, "-1")

    def _api_context(self) -> None:
        try:
            context = self._read_context()
        except OSError as e:
            self._json_response(503, {"status": "error", "message": str(e)})
            return
        self._json_response(200, {"status": "ok", "context": context})

    def _api_camera(self) -> None:
        try:
            payload = self._read_camera_payload()
            if not isinstance(payload, dict) or set(payload) != {"parameter", "value"}:
                raise CameraApiError(400, "Expected an object with parameter and value")
            parameter = payload["parameter"]
            value = payload["value"]
            if parameter not in CAMERA_PARAMETERS:
                raise CameraApiError(400, "parameter must be exposure_us or gain")
            if not camera_finite_number(value):
                raise CameraApiError(400, "value must be a finite number")
            camera = update_camera(parameter, value)
            self._json_response(200, {"status": "ok", "camera": camera})
        except CameraApiError as error:
            camera = (unavailable_camera_state(str(error), error.camera)
                      if error.code == 503 else error.camera)
            self._json_response(error.code, {"status": "error", "camera": camera,
                                              "message": str(error)})

    def _api_detection(self) -> None:
        try:
            payload = self._read_camera_payload()
            if (not isinstance(payload, dict) or set(payload) != {"enabled"}
                    or not isinstance(payload["enabled"], bool)):
                raise DetectionApiError(400, "Expected an object with a boolean enabled value")
            detection = update_detection(payload["enabled"], self._read_player_paused)
            self._json_response(200, {"status": "ok", "detection": detection})
        except CameraApiError as error:
            self._json_response(error.code, {"status": "error", "detection": None,
                                              "message": str(error)})
        except DetectionApiError as error:
            detection = (unavailable_detection_state(str(error), error.detection)
                         if error.code == 503 else error.detection)
            self._json_response(error.code, {"status": "error", "detection": detection,
                                              "message": str(error)})

    def _read_camera_payload(self) -> object:
        if self.headers.get("Transfer-Encoding") is not None:
            raise CameraApiError(400, "Transfer-Encoding is not supported")
        if self.headers.get_content_type() != "application/json":
            raise CameraApiError(400, "Content-Type must be application/json")
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError as error:
            raise CameraApiError(400, "Invalid Content-Length") from error
        if length <= 0 or length > CAMERA_MAX_BODY_BYTES:
            raise CameraApiError(400, f"JSON body must be between 1 and {CAMERA_MAX_BODY_BYTES} bytes")
        previous_timeout = self.connection.gettimeout()
        try:
            self.connection.settimeout(CAMERA_REQUEST_TIMEOUT)
            body = self.rfile.read(length)
            if len(body) != length:
                raise ValueError("Incomplete body")
            return json.loads(body, parse_constant=camera_reject_json_constant,
                              parse_float=camera_parse_json_float)
        except (OSError, ValueError, RecursionError) as error:
            raise CameraApiError(400, "Invalid or incomplete JSON body") from error
        finally:
            self.connection.settimeout(previous_timeout)

    def _write_fifo(self, path: str, value: str) -> None:
        fd = None
        try:
            fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
            os.write(fd, value.encode())
            self._json_response(200, {"status": "ok"})
        except OSError as e:
            self._json_response(500, {"status": "error", "message": str(e)})
        finally:
            if fd is not None:
                os.close(fd)

    def _read_context(self) -> dict[str, object]:
        context: dict[str, object] = {
            "filename": "not started",
            "recordStatus": "unavailable",
            "recordOn": False,
            "recorderAvailable": False,
            "playing": True,
            "playerAvailable": False,
        }

        parsed_recorder = False
        try:
            with open(CONTEXT_RECORDER_PATH, "r") as f:
                for line in f:
                    name, separator, content = line.partition(":")
                    if not separator:
                        continue
                    value = content.strip()
                    if name == "filename":
                        context["filename"] = value
                        parsed_recorder = True
                    elif name == "enabled":
                        context["recordOn"] = value in ("1", "true")
                        parsed_recorder = True
        except OSError:
            parsed_recorder = False

        if parsed_recorder:
            context["recorderAvailable"] = True
            if context["recordOn"]:
                context["recordStatus"] = "recording"
            elif context["filename"] not in ("", "not started"):
                context["recordStatus"] = "stopped"
            else:
                context["recordStatus"] = "ready"

        try:
            context["playing"] = not self._read_player_paused()
            context["playerAvailable"] = True
        except OSError:
            pass

        context["system"] = self._read_system_status()
        context["camera"] = camera_context_state()
        context["detection"] = detection_context_state()

        return context

    def _read_system_status(self) -> dict[str, object]:
        """采集系统资源占用，单项失败时对应字段为 None。"""
        status: dict[str, object] = {
            "cpuPercent": None,
            "loadAvg": None,
            "memUsedMb": None,
            "memTotalMb": None,
            "memPercent": None,
            "diskUsedGb": None,
            "diskTotalGb": None,
            "diskPercent": None,
            "procName": None,
            "procCpuPercent": None,
            "procMemMb": None,
        }

        try:
            idle, total = read_proc_stat()
            with AutoAimHandler.sample_lock:
                last = AutoAimHandler.last_system_sample
                AutoAimHandler.last_system_sample = (idle, total)
            if last is not None and total > last[1]:
                busy = (total - last[1]) - (idle - last[0])
                status["cpuPercent"] = round(busy / (total - last[1]) * 100, 1)
        except OSError:
            pass

        try:
            status["loadAvg"] = read_load_avg()
        except OSError:
            pass

        try:
            total_kb, available_kb = read_mem_info()
            used_kb = total_kb - available_kb
            status["memUsedMb"] = used_kb // 1024
            status["memTotalMb"] = total_kb // 1024
            status["memPercent"] = round(used_kb / total_kb * 100, 1)
        except OSError:
            pass

        try:
            usage = shutil.disk_usage(AutoAimHandler.root_directory)
            status["diskUsedGb"] = round(usage.used / 1e9, 1)
            status["diskTotalGb"] = round(usage.total / 1e9, 1)
            status["diskPercent"] = round(usage.used / usage.total * 100, 1)
        except OSError:
            pass

        pid = find_autoaim_pid()
        if pid is not None:
            status["procName"] = AUTOAIM_PROCESS_NAME
            try:
                status["procMemMb"] = read_process_rss_kb(pid) // 1024
            except OSError:
                pass
            try:
                ticks = read_process_ticks(pid)
                now = time.monotonic()
                with AutoAimHandler.sample_lock:
                    last = AutoAimHandler.last_proc_sample
                    AutoAimHandler.last_proc_sample = (pid, ticks, now)
                if last is not None and last[0] == pid and now > last[2]:
                    delta = ticks - last[1]
                    status["procCpuPercent"] = round(
                        delta / CLOCK_TICKS / (now - last[2]) / CPU_COUNT * 100, 1)
            except OSError:
                pass

        return status

    def _read_player_paused(self) -> bool:
        parsed = False
        paused = False
        with open(CONTEXT_PLAYER_PATH, "r") as f:
            for line in f:
                name, separator, content = line.partition(":")
                if not separator:
                    continue
                if name != "paused":
                    continue
                paused = content.strip() in ("1", "true")
                parsed = True
        if not parsed:
            raise OSError(f"Empty player context: {CONTEXT_PLAYER_PATH}")
        return paused

    def _json_response(self, code: int, data: dict) -> None:
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args) -> None:
        sys.stderr.write(f"[HTTP] {format % args}\n")

    _POST_ROUTES = {
        "/api/detection": _api_detection,
        "/api/camera": _api_camera,
        "/api/record": _api_record,
        "/api/play_pause": _api_play_pause,
        "/api/step_forward": _api_step_forward,
        "/api/step_backward": _api_step_backward,
    }


# ── 进程管理 ──────────────────────────────────────────────────────────────────

# 父进程内预加载 libc，避免 fork 出的子进程在 preexec 阶段 dlopen
_libc = ctypes.CDLL(ctypes.util.find_library("c")
                    or "libc.so.6", use_errno=True)


def _set_pdeathsig() -> None:
    """Popen preexec 钩子：父进程死亡时，子进程收到 SIGTERM。"""
    _libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


class MediamtxProcess:
    """管理 MediaMTX 子进程的生命周期。"""

    def __init__(self) -> None:
        self.process: subprocess.Popen[str] | None = None

    def start(self, args: list[str], cwd: Path) -> None:
        self.process = subprocess.Popen(
            args, cwd=cwd, start_new_session=True,
            preexec_fn=_set_pdeathsig,
        )

    def terminate(self) -> None:
        proc = self.process
        if proc is None or proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            proc.wait(timeout=MEDIAMTX_STOP_TIMEOUT)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                return
            proc.wait(timeout=MEDIAMTX_STOP_TIMEOUT)


# ── 服务器 ────────────────────────────────────────────────────────────────────


class StreamServer:
    """AutoAim 流媒体服务器，协调 MediaMTX 和 HTTP 服务。"""

    def __init__(
        self,
        install_root: Path,
        player_port: int,
        mediamtx_port: int,
    ) -> None:
        self.install_root = install_root
        self.player_port = player_port
        self.mediamtx_port = mediamtx_port
        self.bin_dir = install_root / "bin"
        self.res_dir = install_root / "res"
        self.mediamtx = MediamtxProcess()
        self.http_server: ThreadingHTTPServer | None = None
        self.shutdown_event = threading.Event()
        self.cleanup_event = threading.Event()

    def run(self) -> int:
        atexit.register(self.cleanup)
        try:
            self.validate_files()
            self.start_mediamtx()
            self.start_http_server()
            self.setup_signal_handlers()
            self.print_startup_info()
            assert self.http_server is not None
            self.http_server.serve_forever()
        finally:
            self.cleanup()
        return 0

    def validate_files(self) -> None:
        required = [
            self.bin_dir / "mediamtx",
            self.res_dir / "mediamtx.yml",
            self.res_dir / PLAYER_FILE,
        ]
        for path in required:
            if not path.is_file():
                raise SystemExit(f"Missing file: {path}")

    def start_mediamtx(self) -> None:
        args = [
            str(self.bin_dir / "mediamtx"),
            str(self.res_dir / "mediamtx.yml"),
        ]
        self.mediamtx.start(args, self.install_root)
        threading.Thread(target=self.watch_mediamtx, daemon=True).start()

    def watch_mediamtx(self) -> None:
        proc = self.mediamtx.process
        if proc is None:
            return
        exit_code = proc.wait()
        if exit_code != 0:
            print(f"MediaMTX exited with code {exit_code}", file=sys.stderr)
        self.shutdown()

    def start_http_server(self) -> None:
        AutoAimHandler.root_directory = str(self.install_root)
        self.http_server = ThreadingHTTPServer(
            ("0.0.0.0", self.player_port),
            partial(AutoAimHandler, directory=str(self.install_root)),
        )

    def setup_signal_handlers(self) -> None:
        signal.signal(signal.SIGINT, lambda *_: self.shutdown())
        signal.signal(signal.SIGTERM, lambda *_: self.shutdown())

    def shutdown(self) -> None:
        if self.shutdown_event.is_set():
            return
        self.shutdown_event.set()
        if self.http_server:
            threading.Thread(target=self.http_server.shutdown,
                             daemon=True).start()

    def cleanup(self) -> None:
        if self.cleanup_event.is_set():
            return
        self.cleanup_event.set()
        self.mediamtx.terminate()
        if self.http_server:
            self.http_server.server_close()

    def print_startup_info(self) -> None:
        print("AutoAim stream server started.\n")
        print(f"Please access -> http://<ip>:{self.player_port}/autoaim\n")
        print("Press Ctrl+C to stop.")


# ── 入口 ──────────────────────────────────────────────────────────────────────


def main() -> int:
    install_root = Path(sys.argv[1]) if len(
        sys.argv) > 1 else DEFAULT_INSTALL_ROOT
    player_port = int(os.environ.get(
        "AUTOAIM_PLAYER_PORT", DEFAULT_PLAYER_PORT))
    mediamtx_port = int(
        os.environ.get("AUTOAIM_MEDIAMTX_PORT", DEFAULT_MEDIAMTX_PORT))

    server = StreamServer(install_root, player_port, mediamtx_port)
    return server.run()


if __name__ == "__main__":
    raise SystemExit(main())
